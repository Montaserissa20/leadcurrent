<% content_for :page_title, "Analytics" %>
<section class="page-heading"><div><span class="eyebrow">SALES PERFORMANCE</span><h1>See what moves your business.</h1><p>Live workspace totals. All time, current records. Currencies stay separate.</p></div><%= link_to "Open pipeline ↗", pipeline_path, class: "button secondary" %></section>
<div class="stats-grid">
  <% [["Active deals", :active_opportunities, opportunities_path(status: "active")], ["Won deals", :won_opportunities, opportunities_path(status: "won")], ["Lost deals", :lost_opportunities, opportunities_path(status: "lost")], ["Overdue leads", :overdue_contacts, leads_path(attention: "overdue")]].each do |label, key, url| %><%= link_to url, class: "stat-card", data: { metric: key } do %><span><%= label %></span><strong><%= @metrics.statistics[key] %></strong><small>View matching records →</small><% end %><% end %>
</div>
<div class="analytics-grid"><section class="panel"><span class="eyebrow">OPEN OPPORTUNITIES</span><h2>Total pipeline value</h2><div class="pipeline-value" data-metric="pipeline"><% if @metrics.pipeline_values.empty? %><p class="muted">No active opportunities yet.</p><% end %><% @metrics.pipeline_values.each do |currency, value| %><strong><%= money value, currency %> <small><%= currency %></small></strong><% end %></div></section>
<section class="panel"><span class="eyebrow">LEAD CONVERSION</span><h2 data-metric="conversion"><%= @metrics.statistics[:conversion_rate] %>%</h2><progress class="conversion-progress" value="<%= @metrics.statistics[:conversion_rate] %>" max="100" aria-label="Lead conversion rate"></progress><p class="muted"><%= @metrics.statistics[:converted_leads] %> converted / <%= @metrics.statistics[:total_leads] %> total leads, including disqualified leads.</p><%= link_to "View converted leads →", leads_path(status: "converted"), class: "text-link" %></section>
<section class="panel"><span class="eyebrow">ALL OPPORTUNITIES</span><h2>Average deal value</h2><div data-metric="average"><% if @metrics.average_values.empty? %><p class="muted">No opportunities to average.</p><% end %><% @metrics.average_values.each do |currency, value| %><p class="average-value"><%= money value, currency %> <small><%= currency %></small></p><% end %></div><p class="form-hint">Arithmetic mean per currency across active and closed opportunities. Display rounded to whole units.</p></section>
<section class="panel"><span class="eyebrow">CLOSED BUSINESS</span><h2>Won versus lost</h2><div class="outcome-row"><%= link_to opportunities_path(status: "won") do %><strong><%= @metrics.statistics[:won_opportunities] %></strong><span>Won →</span><% end %><%= link_to opportunities_path(status: "lost") do %><strong><%= @metrics.statistics[:lost_opportunities] %></strong><span>Lost →</span><% end %></div><% @metrics.won_values.each do |currency, value| %><p><%= money value, currency %> <%= currency %> won</p><% end %></section></div>
<section class="panel"><div class="panel-header"><h2>Opportunities by stage</h2><span class="muted">Counts and values, including closed deals</span></div><div class="stage-analytics"><% Opportunity::STATUSES.each do |stage| %><a href="<%= opportunities_path(status: stage) %>" class="stage-metric" data-stage-metric="<%= stage %>"><span><%= stage.humanize %></span><strong><%= @metrics.stage_counts.fetch(stage, 0) %></strong><progress value="<%= @metrics.stage_counts.fetch(stage, 0) %>" max="<%= [@metrics.stage_counts.values.sum, 1].max %>" aria-label="<%= stage.humanize %> share"></progress><% @metrics.stage_values.each do |(name, currency), value| %><% if name == stage %><small><%= money value, currency %> <%= currency %></small><% end %><% end %></a><% end %></div></section>
