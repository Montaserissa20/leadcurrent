<% if @form_error %><div class="flash alert" role="alert"><%= @form_error %></div><% end %><%= form_with model: @lead do |f| %><div class="field"><%= f.label :title, "Lead title" %><%= f.text_field :title, required: true, maxlength: 200, placeholder: "Enterprise plan enquiry" %></div><% unless @lead.persisted? %><div class="form-grid"><div class="field"><%= f.label :company_name, "Company name" %><%= f.text_field :company_name, value: params.dig(:lead, :company_name), required: true %></div><div class="field"><%= f.label :industry %><%= f.text_field :industry, value: params.dig(:lead, :industry) %></div><div class="field"><%= f.label :contact_name, "Contact name" %><%= f.text_field :contact_name, value: params.dig(:lead, :contact_name), required: true %></div><div class="field"><%= f.label :contact_email, "Contact email" %><%= f.email_field :contact_email, value: params.dig(:lead, :contact_email), required: true %></div><div class="field"><%= f.label :phone %><%= f.telephone_field :phone, value: params.dig(:lead, :phone) %></div></div><% end %><div class="field"><%= f.label :owner_id, "Owner" %><%= f.collection_select :owner_id, current_user.manager? ? current_user.organization.users.order(:name) : current_user.organization.users.where(id: @lead.owner_id || current_user.id), :id, :name, { selected: @lead.owner_id || current_user.id }, disabled: !current_user.manager? && @lead.persisted? %></div><div class="field"><%= f.label :notes %><%= f.text_area :notes, rows: 4 %></div><div class="form-footer"><%= f.submit @lead.persisted? ? "Save lead" : "Create lead", class: "button", data: { turbo_submits_with: "Saving…" } %><%= link_to "Cancel", leads_path, class: "button secondary" %></div><% end %>