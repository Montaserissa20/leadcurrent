<% content_for :page_title, "Leads" %><section class="page-heading"><div><span class="eyebrow">TURN POSSIBILITY INTO PROGRESS</span><h1>Leads</h1><p>Start the conversation. Build the relationship.</p></div><%= link_to "+ New lead", new_lead_path, class: "button" %></section><%= render "shared/filters", type: "leads", statuses: Lead::STATUSES %><section class="panel table-panel"><div class="table-scroll"><table><thead><tr><th>Lead / company</th><th>Contact</th><th>Owner</th><th>Status</th><th>First contact</th></tr></thead><tbody><% @leads.each do |lead| %><tr><td><%= link_to lead.title, lead, class: "record-title", aria: { label: "Open #{lead.title} at #{lead.company.name}" } %><small><%= lead.company.name %></small></td><td><%= lead.contact.name %><small><%= lead.contact.email %></small></td><td><%= lead.owner.name %></td><td><%= status_badge lead %></td><td class="<%= 'urgent' if lead.overdue? %>"><%= deadline_text lead %></td></tr><% end %></tbody></table></div><% if @leads.empty? %><div class="empty-state"><h2>Every win begins with a lead.</h2><p>Create one or adjust your filters.</p><%= link_to "Create your first lead", new_lead_path, class: "button" %></div><% end %><p class="table-note">Showing up to 100 matching leads.</p></section>