<% content_for :page_title, "Lead details" %><%= link_to "← Leads", leads_path, class: "back-link" %><section class="page-heading"><div><span class="eyebrow"><%= @lead.company.name %></span><h1><%= @lead.title %></h1><p><%= @lead.contact.name %> · <%= @lead.contact.email %> · <%= @lead.owner.name %></p></div><div class="heading-actions"><%= status_badge @lead %><% if editable?(@lead) %><%= link_to "Edit lead", edit_lead_path(@lead), class: "button secondary" %><% end %></div></section><div class="deadline-banner <%= 'overdue' if @lead.overdue? %>"><strong><%= deadline_text @lead %></strong><span>Deadline: <%= l @lead.first_contact_deadline, format: :long %> · <%= current_user.time_zone %></span></div>
<%= render "ai/panel", record: @lead %>
<div class="detail-grid"><div><% if @lead.notes.present? %><section class="panel"><h2>Lead notes</h2><p><%= @lead.notes %></p></section><% end %><% if editable?(@lead) && !@lead.status.in?(%w[converted disqualified]) %><section class="panel"><h2>Keep the conversation moving</h2><% if @recommendation %><div class="profile-recommendation"><span class="eyebrow">NEXT RECOMMENDED ACTION · PRIORITY <%= @recommendation.priority %></span><p class="reason"><%= @recommendation.reason %></p><% if @recommendation.task %><%= button_to "Complete follow-up", complete_task_path(@recommendation.task), params: { from_profile: true }, class: "button small secondary" %><% elsif @recommendation.action == :advance %><%= link_to "Review next stage ↓", "#next-stage", class: "text-link" %><% end %></div><% end %><%= render "shared/action_form", record: @lead, from_dashboard: false, action: :contact %></section><% end %><%= render "shared/history", record: @lead %></div><div><%= render "shared/customer_context", record: @lead %><section class="panel"><h2>Move forward</h2><% if editable?(@lead) %><% next_stages(@lead).each do |stage| %><% next if stage == 'contacted' && @lead.first_contact_at.nil? %><%= button_to "Mark #{stage.humanize.downcase}", transition_lead_path(@lead), params: { status: stage }, class: "button #{stage == 'disqualified' ? 'secondary' : ''} full", data: { turbo_confirm: stage == 'disqualified' ? 'Disqualify this lead? This is a terminal state.' : nil } %><% end %><% end %><% if @lead.status == 'new' %><p class="form-hint">A completed customer contact moves this lead to Contacted.</p><% end %><% if @lead.opportunity %><%= link_to "Open connected opportunity →", @lead.opportunity, class: "text-link" %><% end %></section><% if @lead.status == 'qualified' && editable?(@lead) %><section class="panel"><h2>Convert to opportunity</h2><%= form_with scope: :opportunity, url: convert_lead_path(@lead) do |f| %><div class="field"><%= f.label :title, "Opportunity title" %><%= f.text_field :title, value: @lead.title, required: true %></div><div class="form-grid"><div class="field"><%= f.label :value %><%= f.number_field :value, min: 0, step: 0.01, value: 0, required: true %></div><div class="field"><%= f.label :currency %><%= f.select :currency, Opportunity::CURRENCIES %></div></div><div class="field"><%= f.label :expected_closing_date, "Expected closing date" %><%= f.date_field :expected_closing_date, value: 30.days.from_now.to_date, required: true %></div><%= f.submit "Convert lead", class: "button full", data: { turbo_submits_with: "Converting…" } %><% end %></section><% end %><%= render "shared/profile_tasks", record: @lead %></div></div>
