<% content_for :page_title, "Edit task" %><%= link_to "← Customer profile", @task.record, class: "back-link" %>
<section class="page-heading"><div><span class="eyebrow">FOLLOW THROUGH</span><h1>Edit task</h1><p><%= @task.record.title %> · <%= current_user.time_zone %></p></div></section>
<section class="panel form-panel"><%= form_with model: @task do |f| %><div class="field"><%= f.label :title, "Task title" %><%= f.text_field :title, required: true, maxlength: 200 %></div><div class="field"><%= f.label :due_at, "Due at" %><%= f.datetime_local_field :due_at, required: true %></div><div class="form-footer"><%= f.submit "Save task", class: "button", data: { turbo_submits_with: "Saving…" } %><%= link_to "Cancel", @task.record, class: "button secondary" %></div><% end %></section>
