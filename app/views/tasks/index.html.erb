<% content_for :page_title, "Tasks" %>
<section class="page-heading"><div><span class="eyebrow">FOLLOW THROUGH</span><h1>Tasks & follow-ups</h1><p>A scheduled task is a promise. A completed contact is the conversation.</p></div><%= link_to "Choose a customer to create a task →", leads_path, class: "button secondary" %></section>
<%= form_with url: tasks_path, method: :get, class: "filters" do |f| %><%= f.hidden_field :contact_id, value: params[:contact_id] if params[:contact_id].present? %><%= f.hidden_field :lead_id, value: params[:lead_id] if params[:lead_id].present? %><%= f.hidden_field :opportunity_id, value: params[:opportunity_id] if params[:opportunity_id].present? %><div class="search-field"><%= f.label :q, "Search tasks" %><%= f.search_field :q, value: params[:q], placeholder: "Search task title" %></div><div><%= f.label :status, "Task status" %><%= f.select :status, [["All tasks", ""], ["Pending", "pending"], ["Overdue", "overdue"], ["Today", "today"], ["Completed", "completed"]], selected: params[:status] %></div><%= f.submit "Filter", class: "button secondary" %><%= link_to "Reset", tasks_path, class: "text-link" %><% end %>
<section class="panel"><% if @tasks.empty? %><div class="empty-state"><strong>No matching follow-ups.</strong><p>Adjust your filters or create a task from a customer profile.</p></div><% end %>
<% @tasks.each do |task| %><div class="record-row" data-task-id="<%= task.id %>"><div class="grow"><%= link_to task.title, task.record, class: "record-title" %><small><%= task.record.title %> · <%= task.owner.name %> · <%= l task.due_at, format: :short %> · <%= current_user.time_zone %></small></div><% if task.completed_at %><span class="badge status-won">Completed</span><% else %><span class="badge <%= task.due_at < Time.current ? 'status-lost' : 'neutral' %>"><%= task.due_at < Time.current ? 'Overdue' : 'Pending' %></span><% if editable?(task) && editable?(task.record) %><div class="inline-actions"><%= link_to "Edit task", edit_task_path(task), class: "text-link" %><%= button_to "Complete", complete_task_path(task), class: "button small secondary", data: { turbo_submits_with: "Completing…" } %></div><% end %><% end %></div><% end %><p class="table-note">Showing up to 100 tasks. Pending tasks first, earliest due first. Task completion does not satisfy first contact.</p></section>
