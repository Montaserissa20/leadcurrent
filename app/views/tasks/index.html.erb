<% content_for :page_title, "Tasks" %><section class="page-heading"><div><span class="eyebrow">FOLLOW THROUGH</span><h1>Tasks & follow-ups</h1><p>A scheduled task is a promise. A completed contact is the conversation.</p></div><%= link_to params[:status] == 'pending' ? 'Show all' : 'Pending only', tasks_path(status: params[:status] == 'pending' ? nil : 'pending'), class: "button secondary" %></section><section class="panel"><% if @tasks.empty? %><div class="empty-state">No follow-ups here yet. Schedule one from a lead, opportunity, or Next Best Action.</div><% end %><% @tasks.each do |task| %><div class="record-row"><div><%= link_to task.title, task.record, class: "record-title" %><small><%= task.owner.name %> · <%= l task.due_at, format: :short %> · <%= current_user.time_zone %></small></div><% if task.completed_at %><span class="badge status-won">Completed</span><% else %><% if task.due_at < Time.current %><span class="badge status-lost">Overdue</span><% end %><% if editable?(task) %><%= button_to "Complete", complete_task_path(task), class: "button small secondary" %><% end %><% end %></div><% end %><p class="table-note">Showing up to 100 tasks.</p></section>