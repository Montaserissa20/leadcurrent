<% content_for :page_title, "Opportunities" %><section class="page-heading"><div><span class="eyebrow">FROM CONVERSATION TO COMMITMENT</span><h1>Opportunities</h1><p>Keep every deal moving with purpose.</p></div><%= link_to "View pipeline ↗", pipeline_path, class: "button secondary" %></section><%= render "shared/filters", type: "opportunities", statuses: Opportunity::STATUSES %><section class="panel table-panel"><div class="table-scroll"><table><thead><tr><th>Opportunity / company</th><th>Owner</th><th>Value</th><th>Stage</th><th>Expected close</th></tr></thead><tbody><% @opportunities.each do |deal| %><tr><td><%= link_to deal.title, deal, class: "record-title" %><small><%= deal.company.name %></small></td><td><%= deal.owner.name %></td><td><%= money deal.value, deal.currency %> <small><%= deal.currency %></small></td><td><%= status_badge deal %></td><td><%= deal.expected_closing_date %></td></tr><% end %></tbody></table></div><% if @opportunities.empty? %><div class="empty-state"><h2>Your next opportunity is a conversation away.</h2><p>Qualify and convert a lead, or adjust your filters.</p><%= link_to "Explore leads", leads_path, class: "button" %></div><% end %><p class="table-note">Showing up to 100 matching opportunities.</p></section>