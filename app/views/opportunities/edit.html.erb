<% content_for :page_title, "Edit opportunity" %><section class="page-heading"><h1>Edit opportunity</h1></section><section class="panel form-panel"><% if @form_error %><div class="flash alert" role="alert"><%= @form_error %></div><% end %><%= form_with model: @opportunity do |f| %><div class="field"><%= f.label :title %><%= f.text_field :title, required: true, maxlength: 200 %></div><div class="form-grid"><div class="field"><%= f.label :value %><%= f.number_field :value, required: true, min: 0, step: 0.01 %></div><div class="field"><%= f.label :currency %><%= f.select :currency, Opportunity::CURRENCIES %></div></div><div class="field"><%= f.label :expected_closing_date %><%= f.date_field :expected_closing_date, required: true %></div><div class="field"><%= f.label :owner_id, "Owner" %><%= f.collection_select :owner_id, current_user.manager? ? current_user.organization.users : current_user.organization.users.where(id: @opportunity.owner_id), :id, :name, {}, disabled: !current_user.manager? %></div><%= f.submit "Save opportunity", class: "button", data: { turbo_submits_with: "Saving…" } %><% end %></section>