<% content_for :page_title, "Pipeline" %><section class="page-heading"><div><span class="eyebrow">SEE THE MOMENTUM</span><h1>Sales pipeline</h1><p>A clear path from qualification to your next win.</p></div><%= link_to "List view", opportunities_path, class: "button secondary" %></section><%= render "shared/filters", type: "opportunities", statuses: Opportunity::STATUSES %><div class="kanban"><% Opportunity::STATUSES.each do |stage| %><section class="kanban-column" data-stage="<%= stage %>"><header><h2><span class="stage-dot status-<%= stage %>"></span><%= stage.humanize %></h2><span class="badge neutral"><%= (@by_stage[stage] || []).size %></span></header><% (@by_stage[stage] || []).group_by(&:currency).each do |currency, deals| %><p class="column-total"><%= money deals.sum(&:value), currency %> <%= currency %></p><% end %><% (@by_stage[stage] || []).each do |deal| %><article class="deal-card" data-deal-id="<%= deal.id %>"><small><%= deal.company.name %></small><%= link_to deal.title, deal, class: "record-title" %><strong class="deal-value"><%= money deal.value, deal.currency %> <small><%= deal.currency %></small></strong><div class="deal-meta"><span><%= deal.owner.name %></span><span><%= deal.expected_closing_date.strftime('%d %b') %></span></div><%= render "stage_form", opportunity: deal, from_pipeline: true %></article><% end %><% if (@by_stage[stage] || []).empty? %><div class="kanban-empty">Room for the next move.</div><% end %></section><% end %></div>