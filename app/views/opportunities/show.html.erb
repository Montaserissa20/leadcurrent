<% content_for :page_title, "Opportunity details" %><%= link_to "← Opportunities", opportunities_path, class: "back-link" %><section class="page-heading"><div><span class="eyebrow"><%= @opportunity.company.name %></span><h1><%= @opportunity.title %></h1><p><%= @opportunity.contact.name %> · <%= @opportunity.owner.name %></p></div><div class="heading-actions"><%= status_badge @opportunity %><% if editable?(@opportunity) %><%= link_to "Edit opportunity", edit_opportunity_path(@opportunity), class: "button secondary" %><% end %></div></section><div class="deal-strip"><div><small>Deal value</small><strong><%= money @opportunity.value, @opportunity.currency %> <%= @opportunity.currency %></strong></div><div><small>Expected close</small><strong><%= @opportunity.expected_closing_date %></strong></div><div><small>Original lead</small><%= link_to @opportunity.lead.title, @opportunity.lead %></div><% if @opportunity.closed_at %><div><small>Closed</small><strong><%= l @opportunity.closed_at, format: :short %></strong></div><% end %></div>
<%= render "ai/panel", record: @opportunity %>
<div class="detail-grid"><div><% if editable?(@opportunity) && !@opportunity.terminal? %><section class="panel"><h2>Log a conversation</h2><% if @recommendation %><div class="profile-recommendation"><span class="eyebrow">NEXT RECOMMENDED ACTION · PRIORITY <%= @recommendation.priority %></span><p class="reason"><%= @recommendation.reason %></p><% if @recommendation.task %><%= button_to "Complete follow-up", complete_task_path(@recommendation.task), params: { from_profile: true }, class: "button small secondary" %><% elsif @recommendation.action == :advance %><%= link_to "Review next stage ↓", "#next-stage", class: "text-link" %><% end %></div><% end %><%= render "shared/action_form", record: @opportunity, from_dashboard: false, action: :contact %></section><% end %><%= render "shared/history", record: @opportunity %></div><div><%= render "shared/customer_context", record: @opportunity %><section class="panel" id="next-stage"><h2>Next stage</h2><%= render "stage_form", opportunity: @opportunity, from_pipeline: false %><% if @opportunity.terminal? %><p>This opportunity is closed. Its history remains available.</p><% end %><p class="form-hint">Qualification → Proposal → Negotiation → Won. An open opportunity can be closed as Lost.</p></section><%= render "shared/profile_tasks", record: @opportunity %></div></div>
