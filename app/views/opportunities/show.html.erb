<% content_for :page_title, "Opportunity details" %><%= link_to "← Opportunities", opportunities_path, class: "back-link" %><section class="page-heading"><div><span class="eyebrow"><%= @opportunity.company.name %></span><h1><%= @opportunity.title %></h1><p><%= @opportunity.contact.name %> · <%= @opportunity.owner.name %></p></div><div class="heading-actions"><%= status_badge @opportunity %><% if editable?(@opportunity) %><%= link_to "Edit opportunity", edit_opportunity_path(@opportunity), class: "button secondary" %><% end %></div></section><div class="deal-strip"><div><small>Deal value</small><strong><%= money @opportunity.value, @opportunity.currency %> <%= @opportunity.currency %></strong></div><div><small>Expected close</small><strong><%= @opportunity.expected_closing_date %></strong></div><div><small>Original lead</small><%= link_to @opportunity.lead.title, @opportunity.lead %></div><% if @opportunity.closed_at %><div><small>Closed</small><strong><%= l @opportunity.closed_at, format: :short %></strong></div><% end %></div><div class="detail-grid"><div><% if editable?(@opportunity) && !@opportunity.terminal? %><section class="panel"><h2>Log a conversation</h2><%= render "shared/action_form", record: @opportunity, from_dashboard: false, action: :contact %></section><% end %><%= render "shared/history", record: @opportunity %></div><div><section class="panel"><h2>Next stage</h2><%= render "stage_form", opportunity: @opportunity, from_pipeline: false %><% if @opportunity.terminal? %><p>This opportunity is closed. Its history remains available.</p><% end %><p class="form-hint">Qualification → Proposal → Negotiation → Won. An open opportunity can be closed as Lost.</p></section><section class="panel"><h2>Follow-ups</h2><% @opportunity.tasks.order(:due_at).each do |task| %><div class="task-preview"><div><%= task.title %><small><%= task.completed_at ? 'Completed' : l(task.due_at, format: :short) %></small></div></div><% end %><%= link_to "Manage tasks →", tasks_path, class: "text-link" %></section></div></div>