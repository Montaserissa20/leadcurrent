<%= form_with url: request.path, method: :get, class: "filters" do |f| %><div class="search-field"><%= f.label :q, "Search", class: "sr-only" %><%= f.search_field :q, value: params[:q], placeholder: "Search #{type} or company…" %></div><div><%= f.label :status, "Status", class: "sr-only" %><%= f.select :status, statuses.map { |s| [s.humanize, s] }, { include_blank: "All stages", selected: params[:status] } %></div><div><%= f.label :owner_id, "Owner", class: "sr-only" %><%= f.collection_select :owner_id, current_user.organization.users.order(:name), :id, :name, { include_blank: "All owners", selected: params[:owner_id] } %></div><% if type == "leads" %><div><%= f.label :attention, "First contact", class: "sr-only" %><%= f.select :attention, [["Any deadline", ""], ["Overdue", "overdue"]], selected: params[:attention] %></div><% end %><%= f.submit "Filter", class: "button secondary" %><%= link_to "Clear", request.path, class: "text-link" %><% end %>