<%= form_with url: actions_path, class: "action-form" do |f| %>
  <%= f.hidden_field :record_type, value: record.class.name %><%= f.hidden_field :record_id, value: record.id %><%= f.hidden_field :from_dashboard, value: from_dashboard %>
  <div class="form-grid"><div><%= f.label :action_kind, "Activity", for: "kind_#{record.class.name}_#{record.id}" %><%= f.select :action_kind, [["Completed customer contact", "contact"], ["Add a note", "note"], ["Schedule follow-up only", "follow_up"]], { selected: action.to_s == 'follow_up' ? 'follow_up' : 'contact' }, id: "kind_#{record.class.name}_#{record.id}" %></div><div><%= f.label :follow_up_at, "Next follow-up (optional)", for: "follow_#{record.class.name}_#{record.id}" %><%= f.datetime_local_field :follow_up_at, value: 1.day.from_now.strftime('%Y-%m-%dT%H:%M'), id: "follow_#{record.class.name}_#{record.id}" %></div></div>
  <div class="form-row"><div class="grow"><%= f.label :body, "What happened?", for: "body_#{record.class.name}_#{record.id}" %><%= f.text_field :body, placeholder: "Add the outcome of your conversation", maxlength: 5000, id: "body_#{record.class.name}_#{record.id}" %></div><%= f.submit "Save action", class: "button", data: { turbo_submits_with: "Saving…" } %></div>
  <p class="form-hint">Record contact only after a completed call, meeting, or customer message. Scheduling alone does not satisfy first contact. Times: <%= current_user.time_zone %>.</p>
<% end %>