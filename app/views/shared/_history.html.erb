<section class="panel"><div class="panel-header"><h2>Activity history</h2><span class="muted">Most recent 50 customer interactions</span></div><% activities = @profile ? @profile.activities : record.activities.includes(:actor).order(completed_at: :desc).limit(50) %><% if activities.empty? %><div class="empty-state">A fresh start. Record your first customer conversation.</div><% end %><% activities.each do |activity| %><div class="timeline-item"><span class="timeline-dot"></span><div><strong><%= activity.kind.humanize %> · <%= link_to (activity.lead || activity.opportunity).title, (activity.lead || activity.opportunity) %></strong><p><%= activity.body %></p><small><%= activity.actor.name %> · <%= l activity.completed_at, format: :short %></small></div></div><% end %><h3 class="section-label">Workflow events</h3><% current_user.organization.audit_events.where(record_type: record.class.name, record_id: record.id).includes(:actor).order(created_at: :desc).limit(30).each do |event| %><div class="audit-row"><span><%= event.action.humanize %><% if event.details['to'] %> → <%= event.details['to'].humanize %><% end %></span><small><%= event.actor.name %> · <%= l event.created_at, format: :short %></small></div><% end %></section>