<section class="signup-card panel"><a class="brand" href="/login"><img src="/icon.svg" alt="" width="34" height="34">LeadCurrent</a><h1>Start your next chapter.</h1><p class="muted">A private workspace for you and your sales team.</p><% if @form_error %><p class="flash alert" role="alert"><%= @form_error %></p><% end %><%= form_with model: @user, url: signup_path do |f| %><div class="field"><%= label_tag :workspace_name, "Workspace name" %><%= text_field_tag :workspace_name, params[:workspace_name], required: true, maxlength: 150 %></div><div class="field"><%= f.label :name, "Your name" %><%= f.text_field :name, required: true %></div><div class="field"><%= f.label :email %><%= f.email_field :email, required: true, autocomplete: "username" %></div><div class="field"><%= f.label :password, "Password (12+ characters)" %><%= f.password_field :password, required: true, minlength: 12, autocomplete: "new-password" %></div><div class="field"><%= f.label :password_confirmation %><%= f.password_field :password_confirmation, required: true, autocomplete: "new-password" %></div><%= f.submit "Create workspace", class: "button full", data: { turbo_submits_with: "Creating…" } %><% end %><p class="auth-footer"><%= link_to "Already have a workspace? Sign in", login_path %></p></section>