<% content_for :page_title, "Overview" %>
<section class="page-heading"><div><span class="eyebrow">YOUR DAY, WITH DIRECTION</span><h1>Make your next move count.</h1><p>Welcome back, <%= current_user.name.split.first %>. Here’s where a little attention goes a long way.</p></div><%= link_to "View pipeline ↗", pipeline_path, class: "button secondary" %></section>
<div class="stats-grid">
  <% [["Total leads", :total_leads, "Every new possibility"], ["New leads", :new_leads, "Ready for a conversation"], ["Overdue contacts", :overdue_contacts, "First-contact attention"], ["Active opportunities", :active_opportunities, "Moving toward a close"]].each do |label, key, hint| %><article class="stat-card <%= 'warning' if key == :overdue_contacts && @statistics[key] > 0 %>" data-stat="<%= key %>"><span><%= label %></span><strong><%= @statistics[key] %></strong><small><%= hint %></small></article><% end %>
</div>
<div class="dashboard-grid"><div class="main-column">
  <section class="panel next-action"><div class="panel-header"><div><span class="eyebrow"><span class="live-dot"></span> FOCUS ON WHAT MATTERS</span><h2>Next Best Action</h2></div><span class="badge neutral"><%= @recommendations.size %> priorities</span></div><p class="panel-intro">A clear reason. A useful next step. Take care of both right here.</p>
  <% if @recommendations.empty? %><div class="empty-state"><strong>You’re all caught up.</strong><p>Create a lead or review your pipeline to keep the momentum going.</p></div><% end %>
  <% @recommendations.each do |entry| %><article class="recommendation" data-recommendation-id="<%= entry.record.id %>"><div class="recommendation-header"><span class="company-avatar"><%= entry.record.company.name.first %></span><div class="grow"><%= link_to entry.record.title, entry.record, class: "record-title" %><small><%= entry.record.company.name %> · <%= entry.record.owner.name %></small></div><%= status_badge entry.record %></div><p class="reason <%= 'urgent' if entry.priority >= 90 %>"><span aria-hidden="true">◷</span> <%= entry.reason %></p><%= render "shared/action_form", record: entry.record, from_dashboard: true, action: entry.action %><% if entry.action == :advance %><%= render "opportunities/stage_form", opportunity: entry.record, from_pipeline: false %><% end %></article><% end %>
  </section>
  <section class="panel"><div class="panel-header"><h2>Recently updated</h2><%= link_to "All leads →", leads_path, class: "text-link" %></div><% if @recent.empty? %><div class="empty-state">Your workspace is ready for its first lead.</div><% end %><% @recent.each do |record| %><div class="record-row"><div><%= link_to record.title, record, class: "record-title" %><small><%= record.company.name %> · <%= record.class.name %></small></div><%= status_badge record %></div><% end %></section>
</div><div class="side-column">
  <section class="panel pipeline-summary"><span class="eyebrow">THE BIG PICTURE</span><h2>Your pipeline</h2><div data-stat="pipeline_value" class="pipeline-value"><% if @pipeline_values.empty? %><strong>$0</strong><% end %><% @pipeline_values.each do |currency, value| %><strong><%= money value, currency %> <small><%= currency %></small></strong><% end %></div><p class="muted">Across <%= @statistics[:active_opportunities] %> active opportunities</p><div class="stage-list"><% Opportunity::STATUSES.each do |stage| %><div><span class="stage-dot status-<%= stage %>"></span><span><%= stage.humanize %></span><strong><%= @stage_counts.fetch(stage, 0) %></strong></div><% end %></div><%= link_to "Explore pipeline ↗", pipeline_path, class: "button secondary full" %></section>
  <section class="panel won-panel"><span class="eyebrow">WINS WORTH CELEBRATING</span><h2 data-stat="won_opportunities"><%= @statistics[:won_opportunities] %> deals won</h2><div data-stat="won_value"><% @won_values.each do |currency, value| %><strong><%= money value, currency %> <%= currency %></strong><% end %></div></section>
  <section class="panel"><div class="panel-header"><h2>Coming up</h2><%= link_to "Tasks →", tasks_path, class: "text-link" %></div><p class="muted"><%= @statistics[:overdue_follow_ups] %> overdue follow-ups</p><% if @tasks.empty? %><div class="empty-state compact">No pending follow-ups. Your calendar has room.</div><% end %><% @tasks.each do |task| %><div class="task-preview"><span class="check-circle"></span><div><%= link_to task.title, task.record %><small><%= l task.due_at, format: :short %></small></div></div><% end %></section>
</div></div>
