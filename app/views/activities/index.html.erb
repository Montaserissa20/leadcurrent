<% content_for :page_title, "Activity" %><section class="page-heading"><div><span class="eyebrow">THE STORY SO FAR</span><h1>Activity</h1><p>Conversations and meaningful changes across your workspace.</p></div></section><%= form_with url: activity_path, method: :get, class: "filters" do |f| %><div class="search-field"><%= f.label :q, "Search activity" %><%= f.search_field :q, value: params[:q], placeholder: "Search conversations and notes" %></div><div><%= f.label :kind, "Activity type" %><%= f.select :kind, [["All activity", ""], ["Completed contact", "contact"], ["Notes", "note"]], selected: params[:kind] %></div><%= f.submit "Filter", class: "button secondary" %><%= link_to "Pending follow-ups →", tasks_path(status: "pending"), class: "text-link" %><% end %><section class="panel"><h2>Customer activity</h2><% if @activities.empty? %><div class="empty-state">Your activity history starts with the first conversation.</div><% end %><% @activities.each do |activity| %><div class="timeline-item"><span class="timeline-dot"></span><div><strong><%= activity.kind.humanize %> · <%= link_to (activity.lead || activity.opportunity).title, (activity.lead || activity.opportunity) %></strong><p><%= activity.body %></p><small><%= activity.actor.name %> · <%= l activity.completed_at, format: :short %></small></div></div><% end %></section><section class="panel"><h2>Audit trail</h2><% @audit_events.each do |event| %><div class="audit-row"><span><%= event.action.humanize %> · <%= event.record_type %> #<%= event.record_id %></span><small><%= event.actor.name %> · <%= l event.created_at, format: :short %></small></div><% end %></section>