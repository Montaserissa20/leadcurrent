<div id="leadcurrent-agent" data-turbo-permanent data-controller="page-agent" data-page-agent-user-id-value="<%= current_user.id %>" data-page-agent-delay-value="<%= Rails.env.test? && ENV['LEADCURRENT_LIVE_AGENT'] != '1' ? 0 : 400 %>" data-engine="@page-agent/core@1.12.4">
  <button type="button" class="button agent-launcher" data-action="page-agent#open" aria-controls="agent-panel" aria-expanded="false">✦ AI Agent</button>
  <aside id="agent-panel" class="agent-panel" aria-labelledby="agent-heading" data-page-agent-target="panel" data-action="keydown->page-agent#keydown" hidden>
    <header><div><span class="eyebrow">SAFE MODE · ALIBABA PAGE AGENT</span><h2 id="agent-heading">LeadCurrent AI Copilot</h2></div><button type="button" class="icon-button" aria-label="Close AI Copilot" data-action="page-agent#close">×</button></header>
    <details class="agent-privacy"><summary>About Safe Mode &amp; privacy</summary><p>Ask about LeadCurrent, your team, leads, deals or follow-ups. Facts come from authorized CRM queries; explanations are AI-generated. Only you can submit changes.</p><p class="form-hint">Run sends bounded questions and recent intent history to Groq. Browser actions also send limited visible control labels and record titles. Team rows, notes, contact details and security pages are excluded. Masking is not perfect anonymity.</p><small>Safe Mode blocks CRM submissions, conversion, stages, task completion, settings, external links and generated JavaScript. Review prepared notes before manually saving.</small></details>
    <div class="copilot-conversation" role="log" aria-live="polite" aria-relevant="additions text" aria-label="Copilot conversation" data-page-agent-target="conversation"></div>
    <form class="copilot-composer" data-action="submit->page-agent#run"><div class="field"><label for="agent-task">What would you like to do?</label><textarea id="agent-task" rows="2" maxlength="600" data-page-agent-target="task" aria-describedby="agent-keyboard" placeholder="How many users are in my team?"></textarea></div><div class="agent-buttons"><button type="submit" class="button" data-page-agent-target="run">Run</button><button type="button" class="button secondary" data-page-agent-target="stop" data-action="page-agent#stop" disabled>Stop</button><button type="button" class="text-link" data-action="page-agent#resetConversation">New chat</button></div><small id="agent-keyboard">Ctrl/⌘ + Enter to send · Escape to close</small></form>
    <details class="agent-examples"><summary>Example tasks</summary><% ["Find my overdue leads.", "Open Atlas Industries.", "Open opportunities in negotiation.", "Show today's pending follow-ups.", "Prepare a follow-up note for this customer.", "Navigate to sales analytics."].each do |task| %><button type="button" class="text-link" data-action="page-agent#suggest"><%= task %></button><% end %></details>
    <p class="agent-state" role="status" aria-live="polite">Status: <strong data-page-agent-target="status">idle</strong></p>
    <p class="form-hint">Short-lived chat context expires after 10 minutes idle. Browser actions use up to 6 steps. Quota waits are shown when needed; an in-flight server request may still finish after Stop.</p>
    <details class="agent-activity"><summary>Agent activity</summary><ol class="agent-steps" data-page-agent-target="steps" aria-label="Agent activity"></ol></details><p class="agent-result" data-page-agent-target="result" aria-live="polite"></p>
  </aside>
</div>
